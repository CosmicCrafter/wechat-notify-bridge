# Public HTTPS origin/path advertised by OpenAPI; no trailing slash.
WECHAT_PUBLIC_BASE_URL=https://notify.example.com/bridge
# Bind locally; expose through your HTTPS reverse proxy.
WECHAT_BIND=127.0.0.1
WECHAT_PORT=18092

# Optional proxy management; enabled by compose.proxy.yaml only.
# The real URL may contain a token. Keep it in your PRIVATE .env, never Git.
WECHAT_PROXY_SUBSCRIPTION_URL=
WECHAT_PROXY_UPDATE_INTERVAL=21600
WECHAT_PROXY_CHECK_INTERVAL=300
# JSON keyword groups, first matching available tier wins. [] means no region filter.
WECHAT_PROXY_PRIORITIES='["日本 Pro","美国 Pro","新加坡 Pro"]'

# Optional admin form default; Open ID is scoped to each Feishu app.
FEISHU_DEFAULT_OWNER_OPEN_ID=

# Optional legacy OAuth issuer during URL migration; same origin as public base.
WECHAT_OAUTH_BASE_URL=
