  "components": {
    "schemas": {
      "ConversationRegistration": {
        "properties": {
          "conversation_key": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Conversation Key"
          },
          "name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 20,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "conversation_key"
        ],
        "title": "ConversationRegistration"
      },
      "ConversationState": {
        "properties": {
          "active": {
            "type": "boolean",
            "title": "Active"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "active"
        ],
        "title": "ConversationState"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Message": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Text"
          },
          "dedup_key": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Dedup Key"
          },
          "dry_run": {
            "type": "boolean",
            "title": "Dry Run",
            "default": false
          },
          "conversation_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "dedup_key"
        ],
        "title": "Message"
      },
      "Notice": {
        "properties": {
          "task": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Task"
          },
          "reason": {
            "type": "string",
            "maxLength": 800,
            "minLength": 1,
            "title": "Reason"
          },
          "need_user": {
            "type": "string",
            "maxLength": 800,
            "minLength": 1,
            "title": "Need User"
          },
          "dedup_key": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Dedup Key"
          },
          "source": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Source",
            "default": "Codex"
          },
          "level": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "urgent"
            ],
            "title": "Level",
            "default": "warning"
          },
          "dry_run": {
            "type": "boolean",
            "title": "Dry Run",
            "default": false
          },
          "conversation_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "task",
          "reason",
          "need_user",
          "dedup_key"
        ],
        "title": "Notice"
      },
      "TaskCard": {
        "properties": {
          "conversation_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$",
            "title": "Conversation Id"
          },
          "dedup_key": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Dedup Key"
          },
          "title": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Title"
          },
          "prompt": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Prompt"
          },
          "options": {
            "items": {
              "$ref": "#/components/schemas/TaskOption"
            },
            "type": "array",
            "maxItems": 8,
            "title": "Options"
          },
          "mode": {
            "type": "string",
            "enum": [
              "single",
              "multiple",
              "confirm",
              "input"
            ],
            "title": "Mode",
            "default": "single"
          },
          "allow_custom": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Allow Custom"
          },
          "min_choices": {
            "type": "integer",
            "maximum": 8.0,
            "minimum": 1.0,
            "title": "Min Choices",
            "default": 1
          },
          "max_choices": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 8.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Choices"
          },
          "input_hint": {
            "type": "string",
            "maxLength": 200,
            "title": "Input Hint",
            "default": ""
          },
          "expires_in": {
            "type": "integer",
            "maximum": 604800.0,
            "minimum": 60.0,
            "title": "Expires In",
            "default": 86400
          },
          "dry_run": {
            "type": "boolean",
            "title": "Dry Run",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "conversation_id",
          "dedup_key",
          "title",
          "prompt"
        ],
        "title": "TaskCard"
      },
      "TaskOption": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,32}$",
            "title": "Id"
          },
          "label": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Label"
          },
          "description": {
            "type": "string",
            "maxLength": 500,
            "title": "Description",
            "default": ""
          },
          "recommended": {
            "type": "boolean",
            "title": "Recommended",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "title": "TaskOption"
      },
      "TaskUpdate": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "processing",
              "completed",
              "cancelled"
            ],
            "title": "Status"
          },
          "result": {
            "type": "string",
            "maxLength": 4000,
            "title": "Result",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "TaskUpdate"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
